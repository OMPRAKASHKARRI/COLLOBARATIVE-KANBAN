# This repository keeps configuration per package. Copy and fill in:
#   backend/.env.example  -> backend/.env   (DATABASE_URL, JWT secrets, CLIENT_ORIGIN, cookie flags)
#   frontend/.env.example -> frontend/.env  (VITE_API_URL, VITE_SOCKET_URL)
# Never commit a real .env file. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
