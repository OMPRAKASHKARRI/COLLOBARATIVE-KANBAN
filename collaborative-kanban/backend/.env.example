# Copy to .env — NEVER commit the real .env
NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://kanban:CHANGE_ME@localhost:5432/collaborative_kanban?schema=public"
# Generate strong secrets, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Comma-separated list of allowed browser origins (CORS + Socket.IO)
CLIENT_ORIGIN=http://localhost:5173
# Set COOKIE_SECURE=true behind HTTPS; use COOKIE_SAMESITE=none only for cross-site deployments (requires secure)
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
